# Copiá este archivo como .env en local. En Railway se cargan como Variables.
# NUNCA subas el archivo .env a GitHub.

# --- Base de datos (Supabase Session pooler recomendado) -------------------
DATABASE_URL="postgresql://postgres.PROYECTO:TU_CONTRASENA@aws-0-us-east-1.pooler.supabase.com:5432/postgres"
# true | false | (omitir: se detecta solo con Supabase/Railway/Neon)
DATABASE_SSL=true

# Cadena larga y aleatoria (mín. 16 caracteres). Obligatoria en producción.
JWT_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"
# Horas de vigencia del token JWT (por defecto 8). La inactividad de ~18 min se maneja en el frontend.
# HORAS_SESION=8

PORT=3001

# Origen(es) del frontend. En producción: URL de Vercel (sin barra final).
# Varios orígenes separados por coma.
# Local:
ORIGEN_PERMITIDO=http://localhost:5173
# Producción (ejemplo):
# ORIGEN_PERMITIDO=https://tu-app.vercel.app
